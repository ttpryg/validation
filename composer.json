{
    "name": "ttpryg/validation",
    "description": "Framework-agnostic Laravel-style validation layer on top of Symfony Validator for PHP 8.1+.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "validation",
        "validator",
        "symfony-validator",
        "constraints",
        "rules"
    ],
    "authors": [
        {
            "name": "Toto",
            "email": "totoprayogo1916@gmail.com",
            "homepage": "https://ttpryg.my.id"
        }
    ],
    "require": {
        "php": "^8.1",
        "symfony/validator": "^6.4 || ^7.0"
    },
    "require-dev": {
        "laravel/pint": "^1.20",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^10.0",
        "rector/rector": "^2.6"
    },
    "autoload": {
        "psr-4": {
            "Ttpryg\\Validation\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Ttpryg\\Validation\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "vendor/bin/phpstan analyse",
        "fix:check": [
            "vendor/bin/rector process --dry-run",
            "vendor/bin/pint --test"
        ],
        "fix": [
            "vendor/bin/rector process",
            "vendor/bin/pint"
        ]
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
